// User function Template for Java

class Solution {
    static int leastInterval(int N, int K, char tasks[]) {

        // Array to store frequency of each task
        int freq[] = new int[26];

        // Count frequency of tasks
        for(int i = 0; i < N; i++) {
            freq[tasks[i] - 'A']++;
        }

        // Find maximum frequency among all tasks
        int maxfreq = 0;

        for(int i = 0; i < 26; i++) {
            maxfreq = Math.max(maxfreq, freq[i]);
        }

        // Count how many tasks have maximum frequency
        int count = 0;

        for(int i = 0; i < 26; i++) {
            if(freq[i] == maxfreq) {
                count++;
            }
        }

        /*
           Formula:
           (maxfreq - 1) * (K + 1) + count

           maxfreq - 1  -> number of gaps
           K + 1        -> size of each block
           count        -> tasks having maximum frequency
        */
        
        int ans = (maxfreq - 1) * (K + 1) + count;

        // Return maximum between total tasks and calculated answer
        return Math.max(N, ans);
    }
}
