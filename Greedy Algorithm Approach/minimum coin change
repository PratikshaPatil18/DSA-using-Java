class Solution {
    
    static ArrayList<Integer> findMin(int n) {
        
        int[] curr = {2000,500,200,100,50,20,10,5,2,1};
        
        ArrayList<Integer> ans = new ArrayList<>();
        
        int i = 0;
        
        while(n > 0) {
            
            int note = n / curr[i];
            
            while(note > 0) {
                ans.add(curr[i]);
                note--;
            }
            
            n = n % curr[i];
            i++;
        }
        
        return ans;
    }
}
