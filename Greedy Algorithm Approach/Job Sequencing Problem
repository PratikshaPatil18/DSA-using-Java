class Solution {
    
    public ArrayList<Integer> jobSequencing(int[] deadline, int[] profit) {

        // Total number of jobs
        int n = deadline.length;

        // Store deadline and profit together
        int job[][] = new int[n][2];

        // job[i][0] = deadline
        // job[i][1] = profit
        for (int i = 0; i < n; i++) {
            job[i][0] = deadline[i];
            job[i][1] = profit[i];
        }

        // Sort jobs based on profit in descending order
        Arrays.sort(job, (a, b) -> b[1] - a[1]);

        // Find maximum deadline
        int maxdeadline = 0;

        for (int d : deadline) {
            maxdeadline = Math.max(maxdeadline, d);
        }

        // स्लॉट already occupied आहे का ते check करण्यासाठी
        boolean[] slot = new boolean[maxdeadline + 1];

        // Count of jobs done
        int countjob = 0;

        // Total profit earned
        int totalprofit = 0;

        // Traverse all jobs
        for (int i = 0; i < n; i++) {

            int d = job[i][0]; // current job deadline
            int p = job[i][1]; // current job profit

            // Find free slot from deadline to 1
            for (int j = d; j > 0; j--) {

                // If slot is free
                if (!slot[j]) {

                    // Mark slot as occupied
                    slot[j] = true;

                    // Increase completed jobs count
                    countjob++;

                    // Add profit
                    totalprofit += p;

                    // Job assigned successfully
                    break;
                }
            }
        }

        // Store final answer
        ArrayList<Integer> ans = new ArrayList<>();

        ans.add(countjob);
        ans.add(totalprofit);

        return ans;
    }
}
